 #define SC_SENTINEL_HASH (-1)
 
+static unsigned
+statementcache_hash_bin(Py_hash_t hash)
+{
+  Py_uhash_t value = (Py_uhash_t)hash;
+  return (value ^ (value >> 16)) & (SC_HASH_BUCKETS - 1);
+}
