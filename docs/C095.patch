+"""C095 [HIGH] xSetSystemCall(NULL, ...) passes NULL to PyUnicode_FromString
+
+CONFIRMED: crash (SIGSEGV, NULL dereference in strlen)
+Python 3.13.14, debug build.
+
+Layering two APSW VFSes: outer.xSetSystemCall(None, 0) delegates to the inner
+VFS C trampoline which calls PyUnicode_FromString(NULL) -> strlen(NULL).
+
+GDB: SIGSEGV at __strlen_evex (libc)
+     #1 PyUnicode_FromString
+     #2 apswvfs_xSetSystemCall src/vfs.c:1492 (zName=0x0)
+"""
+import apsw
+
+
+class InnerVFS(apsw.VFS):
+    def __init__(self):
+        apsw.VFS.__init__(self, "c095inner", "")
+
+
+class OuterVFS(apsw.VFS):
+    def __init__(self):
+        apsw.VFS.__init__(self, "c095outer", "c095inner")
+
+
+inner = InnerVFS()
+outer = OuterVFS()
+
+# Outer delegates to inner VFS C trampoline with name=None -> NULL
+outer.xSetSystemCall(None, 0)
