+"""PY219 [HIGH] Worker failures are reported but do not fail megatest
+
+CONFIRMED: static analysis (code path verified in source)
+Python 3.13.14.
+
+This test verifies the problematic code pattern exists in the current source
+tree. It does not execute the bug at runtime.
+"""
+from pathlib import Path
+
+def test():
+    src = Path('tools/megatest.py').read_text()
+    needle = 'print("\\t FAIL"'
+    assert needle in src, f"Pattern not found: {needle} in tools/megatest.py"
+    print(f"  tools/megatest.py: OK - worker failure printed but no exit code set")
+
+
+if __name__ == "__main__":
+    test()
+    print("CONFIRMED (static): PY219")
