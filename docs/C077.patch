+NULL via sqlite3_db_mutex(db=0x0).
+
+GDB: SIGSEGV at sqlite3_db_mutex(db=0x0) sqlite3.c:188261
+"""
+import apsw
+
+con = apsw.Connection("")
+cur = con.cursor()
+cur.execute("", explain=1)  # crashes: NULL deref in sqlite3_stmt_explain
