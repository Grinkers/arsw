+tree. It does not execute the bug at runtime.
+"""
+from pathlib import Path
+
+def test():
+    src = Path('tools/megatest.py').read_text()
+    needle = 'build_ext --inplace'
+    assert needle in src, f"Pattern not found: {needle} in tools/megatest.py"
+    print(f"  tools/megatest.py: OK - in-place build before wheel install/test in same directory")
+
+
+if __name__ == "__main__":
+    test()
