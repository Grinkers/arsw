+"""C060 [HIGH] Crafted eight-byte JSONB length wraps bounds and drives OOB scan
+
+CONFIRMED: integer overflow causing OOB heap read
+Python 3.13.14, debug build.
+
+The 9-byte payload fa ff ff ff ff ff ff ff ff encodes JT_TEXTRAW with
+8-byte length SIZE_MAX.  value_offset + tag_len wraps to 8, which passes
+the bounds check.  buf->offset - value_offset underflows to SIZE_MAX.
+The JT_TEXTRAW loop reads SIZE_MAX bytes starting one past the buffer end.
+
+Under ASan this aborts; without ASan it scans until finding a non-ASCII byte.
+"""
+import apsw
+
+payload = bytes([0xFA]) + b"\xff" * 8 + b"A"
+result = apsw.jsonb_detect(payload)
+print(f"detect={result} (OOB read occurred during UTF-8 scan)")
+print("CONFIRMED: integer overflow OOB read in jsonb_detect")
