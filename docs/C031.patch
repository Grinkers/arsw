+"""C031 [HIGH] Virtual-table registration has pre-transfer leak
+
+CONFIRMED: reference leak (datasource survives del + gc.collect())
+Python 3.13.14, debug build.
+
+create_module increfs datasource before vti is fully set up.  If
+apswvtabSetupModuleDef fails (iVersion=5), goto error calls apswvtabFree(vti),
+but vti->datasource was never assigned (still 0 from PyMem_Calloc), so the
+incref'd datasource ref leaks permanently.
+"""
+import apsw, gc, weakref
+
+con = apsw.Connection("")
+
+
+class MyDataSource:
+    pass
+
+
+ds = MyDataSource()
+ds_ref = weakref.ref(ds)
+
+# iVersion=5 makes apswvtabSetupModuleDef return NULL -> goto error
+try:
+    con.create_module("testmod", ds, iVersion=5)
+except ValueError as e:
+    print(f"Registration failed (expected): {e}")
+
+del ds
+gc.collect()
+
+assert ds_ref() is not None, "datasource should still be alive (leaked)"
+print("LEAKED: datasource still alive after del + gc.collect()")
+print("CONFIRMED: reference leak")
