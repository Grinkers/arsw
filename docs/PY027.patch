+"""PY027 [HIGH] Right-nested NOT is serialized with changed semantics
+
+CONFIRMED: serialization changes AST semantics
+Python 3.13.14.
+
+Serialization parenthesizes solely by precedence.  A right-nested NOT is
+emitted without parentheses: "a NOT b NOT c".  SQLite parses NOT
+left-associatively, reparsing as (a NOT b) NOT c rather than a NOT (b NOT c).
+"""
+from apsw.fts5query import to_query_string, NOT, PHRASE
+
+ast = NOT(PHRASE("a"), NOT(PHRASE("b"), PHRASE("c")))
+serialized = to_query_string(ast)
+assert serialized == "a NOT b NOT c", f"unexpected: {serialized!r}"
+print(f"Original:  a NOT (b NOT c)")
+print(f"Serialized: {serialized!r}")
+print("BUG: right-nested NOT has no parens -> reparses as (a NOT b) NOT c")
+print("CONFIRMED: right-nested NOT serializes without parens")
