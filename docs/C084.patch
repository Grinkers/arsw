# C084: Mapper reinitialization leaks resources and can leave stale/dangling state
#
# CONFIRMED — reference leak (reproduced on Python 3.13.14)
#
# Python permits explicit repeated __init__ calls.  from_utf8_position_mapper
# re-init overwrites an existing export/string without cleanup.  Verified:
# refcount of the original string is unchanged after re-init with a different
# string, proving the old export was not released.
#
# Run:
#   PYTHONPATH=. python docs/C084.patch
#
import apsw._unicode as u
import sys

s1 = "hello world"
s2 = "goodbye universe"

fm = u.from_utf8_position_mapper(s1)
rc_before = sys.getrefcount(s1)

fm.__init__(s2)  # re-init leaks old export
rc_after = sys.getrefcount(s1)

assert rc_after >= rc_before, f"expected leak: {rc_before} -> {rc_after}"
print(f"LEAK: s1 refcount {rc_before} -> {rc_after} (old export not released)")
