+"""PY124 [HIGH] Fixed working-directory database names can alter or delete user data
+
+CONFIRMED: static analysis (code path verified in source)
+Python 3.13.14.
+
+This test verifies the problematic code pattern exists in the current source
+tree. It does not execute the bug at runtime.
+"""
+from pathlib import Path
+
+def test():
+    src = Path('examples/main.py').read_text()
+    needle = 'os.remove("myobfudb")'
+    assert needle in src, f"Pattern not found: {needle} in examples/main.py"
+    print(f"  examples/main.py: OK - example unconditionally deletes fixed-name database")
+
+
+if __name__ == "__main__":
+    test()
+    print("CONFIRMED (static): PY124")
