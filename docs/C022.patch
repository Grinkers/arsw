+"""C022 [HIGH] Numeric carray accepts unaligned contiguous buffers
+
+CONFIRMED: undefined behavior (unaligned pointer dereference)
+Python 3.13.14, debug build.
+
+PyBUF_ANY_CONTIGUOUS does not promise alignment.  carray casts the pointer to
+int*/int64*/double*.  An odd-offset byte slice is accepted.  On x86 this does
+not fault, but it is UB (would SIGBUS on strict-alignment targets like ARM).
+"""
+import apsw, struct
+
+con = apsw.Connection("")
+
+raw = bytearray(9)
+struct.pack_into("<ii", raw, 1, 42, 99)
+
+mv = memoryview(raw)[1:9]  # unaligned for 4-byte int access
+ca = apsw.carray(mv, flags=apsw.SQLITE_CARRAY_INT32)
+rows = con.execute("SELECT value FROM carray(?)", (ca,)).fetchall()
+assert rows == [(42,), (99,)], f"Expected [(42,), (99,)], got {rows}"
+print(f"Unaligned int32* dereference accepted: {rows}")
+print("UB -- would fault/SIGBUS on strict-alignment targets")
+print("CONFIRMED: unaligned buffer accepted by carray (UB)")
