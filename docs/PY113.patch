index 00000000..5c041936
--- /dev/null
+++ b/tests/confirmation/PY113.py
@@ -0,0 +1,24 @@
+"""PY113 [HIGH] Python 3.10 cannot parse the TaskGroup cancellation example
+
+CONFIRMED: SyntaxError on Python 3.10
+
+examples/async.py:169 uses asyncio.TaskGroup (3.11+) and line 189 uses
+except* (3.11+).  Python 3.10 cannot parse except* at all.
+
+Run: python3.10 -m tests.confirmation.PY113
+(On 3.11+ this test passes trivially; run on 3.10 to see the failure.)
+"""
+import subprocess, sys
+
+# On 3.10 this file itself is fine, but examples/async.py cannot be compiled
+result = subprocess.run(
+    [sys.executable, "-m", "py_compile", "examples/async.py"],
+    capture_output=True, text=True,
+)
+if sys.version_info < (3, 11):
+    assert result.returncode != 0, "expected py_compile to fail on 3.10"
+    print(f"CONFIRMED: examples/async.py fails to compile on Python {sys.version_info[0]}.{sys.version_info[1]}")
+    print(result.stderr.strip())
+else:
+    print(f"Python {sys.version_info[0]}.{sys.version_info[1]}: examples/async.py compiles (run on 3.10 to see failure)")
+    print("CONFIRMED: except* syntax requires 3.11+")
