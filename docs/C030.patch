+"""C030 [HIGH] Failed window-function registration destroys callback state twice
+
+CONFIRMED: double-free / use-after-free (SIGSEGV under PYTHONMALLOC=debug)
+Python 3.13.14, debug build.
+
+createFunctionApi wraps xDestroy in a FuncDestructor.  When sqlite3CreateFunc
+fails (name > 255 bytes), pArg->nRef stays 0, so createFunctionApi calls
+xDestroy(cbinfo) = apsw_free_func(cbinfo).  APSW's error path then calls
+apsw_free_func(cbinfo) AGAIN.  Under PYTHONMALLOC=debug the freed memory is
+poisoned and the second Py_XDECREF crashes.
+
+Run: PYTHONPATH=. PYTHONMALLOC=debug python -m tests.confirmation.C030
+"""
+import apsw
+
+con = apsw.Connection("")
+
+
+class Win:
+    def __init__(self):
+        self.total = 0
+
+    def step(self, *args):
+        self.total += args[0]
+
+    def inverse(self, *args):
+        self.total -= args[0]
+
+    def value(self):
+        return self.total
+
+    def finalize(self):
+        return self.total
+
+
+# Force SQLite to reject the registration (name > 255 bytes).
+# SQLite calls apsw_free_func (destructor), then APSW calls it again.
+con.create_window_function("x" * 300, Win, -1)
